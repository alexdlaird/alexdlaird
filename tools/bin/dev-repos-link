#!/usr/bin/env python

import os
import sys

DEVELOPER_DIR = os.path.expanduser(os.path.join("~", "Developer"))
PRIVATE_LINK_SCRIPT = os.path.join(DEVELOPER_DIR, "private-dev", "bin", "dev-repos-link")


def main():
    if not os.path.isfile(PRIVATE_LINK_SCRIPT):
        print(f"!!> {PRIVATE_LINK_SCRIPT} does not exist, nothing to link")
        sys.exit(0)

    os.execv(PRIVATE_LINK_SCRIPT, [PRIVATE_LINK_SCRIPT] + sys.argv[1:])


if __name__ == "__main__":
    main()
