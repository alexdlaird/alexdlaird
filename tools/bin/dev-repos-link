#!/usr/bin/env python

import os
import sys

DEVELOPER_DIR = os.path.expanduser(os.path.join("~", "Developer"))
CONTEXT_DIR = os.path.join(DEVELOPER_DIR, "private-dev", "claude")


def symlink(source, dest):
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    if os.path.islink(dest) or os.path.exists(dest):
        if os.path.islink(dest) and os.readlink(dest) == source:
            return
        os.remove(dest)
    os.symlink(source, dest)
    print(f"--> {dest} -> {source}")


def main():
    if not os.path.isdir(CONTEXT_DIR):
        print(f"!!> {CONTEXT_DIR} does not exist, nothing to link")
        sys.exit(0)

    print("---------------------------------------------")
    print(" Linking project context ...")
    print("---------------------------------------------")

    global_md = os.path.join(CONTEXT_DIR, "CLAUDE.md")
    if os.path.exists(global_md):
        symlink(global_md, os.path.expanduser(os.path.join("~", ".claude", "CLAUDE.md")))

    projects_dir = os.path.join(CONTEXT_DIR, "projects")
    if os.path.isdir(projects_dir):
        for filename in sorted(os.listdir(projects_dir)):
            if not filename.endswith(".md"):
                continue
            source = os.path.join(projects_dir, filename)
            relative_path = filename[:-3].replace(".", os.sep)
            dest = os.path.join(DEVELOPER_DIR, relative_path, ".claude", "CLAUDE.md")
            if os.path.isdir(os.path.dirname(os.path.dirname(dest))):
                symlink(source, dest)
            else:
                print(f" -> Skipping {filename} (target repo not cloned)")

    print("---------------------------------------------")
    print(" ... finished linking")
    print("---------------------------------------------")


if __name__ == "__main__":
    main()
