#!/usr/bin/env bash

DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]:-$0}" )" &> /dev/null && pwd )

. "$DIR/../lib/init-helpers.sh"

section_header "Initializing Audio Sink"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "!!> Audio sink setup is only supported on Linux"
  return 0 2>/dev/null || exit 1
fi

PRIVATE_DEV="$HOME/Developer/private-dev"
if [[ ! -d "$PRIVATE_DEV" ]]; then
  echo "!!> $PRIVATE_DEV not found; clone private-dev before provisioning the audio sink."
  return 0 2>/dev/null || exit 1
fi

# Set apt flags based on interactive mode
APT_FLAGS=""
if [[ "$INTERACTIVE" != "true" ]]; then
  APT_FLAGS="-y"
fi

# Capture/serve dependencies. ffmpeg + alsa-utils also come from dev-init-debian;
# netcat lets bin/stream wait for MediaMTX to be listening before it publishes, and
# curl + python3 are used by the video stream, health check, and camera login.
sudo apt-get install $APT_FLAGS ffmpeg alsa-utils netcat-openbsd curl python3
sudo usermod -aG audio "$USER"

# Firewall: LAN-only RTSP + SSH + camera control, everything else denied inbound.
# Off-LAN access is via the OpenVPN, not a public tunnel or direct inbound.
sudo ufw allow from 192.168.86.0/22 to any port 22
sudo ufw allow from 192.168.86.0/22 to any port 8554 proto tcp
sudo ufw allow from 192.168.86.0/22 to any port 8099 proto tcp
sudo ufw default deny incoming
sudo ufw default allow outgoing
if ! sudo ufw status | grep -q "Status: active"; then
  sudo ufw enable
fi

# MediaMTX is a downloaded release binary; its config is versioned in private-dev.
mkdir -p "$HOME/mediamtx" "$HOME/recordings"
if [[ ! -x "$HOME/mediamtx/mediamtx" ]]; then
  MEDIAMTX_VER=$(curl -sL https://api.github.com/repos/bluenviron/mediamtx/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+')
  curl -sL "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VER}/mediamtx_${MEDIAMTX_VER}_linux_amd64.tar.gz" | tar xz -C "$HOME/mediamtx" mediamtx
fi

# Install the core audio/video-sink services (unit files versioned in private-dev):
# the MediaMTX RTSP server (also pulls and records the camera), the ffmpeg capture
# (FLAC archive + AAC publish), the live video+audio publisher, the health check
# that restarts any of them that stall, and the camera on/off control for the app.
for unit in stream-mediamtx stream stream-video stream-healthcheck camera-control; do
  sudo ln -snf "$PRIVATE_DEV/lib/${unit}.service" "/etc/systemd/system/${unit}.service"
done
sudo ln -snf "$PRIVATE_DEV/lib/stream-healthcheck.timer" "/etc/systemd/system/stream-healthcheck.timer"
# The health check runs as root, so it runs a root-owned copy, not the repo's writable script.
# Install it before enabling camera-control: an older copy without the CAMERA_OFF_MARKER check
# would restart stream-mediamtx every ~10 min while the camera is off (and camera-control
# refuses "off" until this copy knows the marker).
sudo install -m 0755 -o root -g root "$PRIVATE_DEV/bin/stream-healthcheck" /usr/local/sbin/stream-healthcheck
sudo systemctl daemon-reload
sudo systemctl enable --now stream-mediamtx.service stream.service stream-video.service stream-healthcheck.timer camera-control.service

# The camera is only pulled when its read-only login is in ~/.env, never the repo.
if [[ ! -f "$HOME/.env" ]] || ! grep -q '^CAMERA_VIEWER_PASS=' "$HOME/.env"; then
  echo "!!> CAMERA_VIEWER_PASS not set in ~/.env; the camera won't be pulled or recorded."
  echo "!!> Add it (see servers/ariel/README.md) and restart stream-mediamtx to enable video."
fi

echo "--> audio sink up: record -> ~/recordings (FLAC), listen -> rtsp://$(hostname):8554/audio"
echo "--> video sink up: record -> ~/recordings/camera, listen -> rtsp://$(hostname):8554/video"
echo "--> set gain: raise ALSA capture (alsamixer / amixer) and the mic's own gain knob"
echo "--> add the nightly prune + disk guard to 'crontab -e' (see servers/ariel/README.md)"

section_footer "Audio sink setup"
