#!/usr/bin/env bash

DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]:-$0}" )" &> /dev/null && pwd )

. "$DIR/../lib/init-helpers.sh"

section_header "Initializing Home Assistant"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "!!> Home Assistant setup is only supported on Linux"
  return 0 2>/dev/null || exit 1
fi

if ! id -nG | tr ' ' '\n' | grep -qx docker; then
  sudo usermod -aG docker "$USER"
  echo "!!> Added $USER to docker group. Please log out and back in, then rerun to complete setup."
  return 0 2>/dev/null || exit 1
fi

# Machine-specific settings live in ~/.env, never the repo:
#   HA_PORT          port HA listens on (default 8123)
#   HA_PACKAGES_DIR  optional directory of versioned YAML packages, mounted read-only
HA_PORT=8123
HA_PACKAGES_DIR=""
if [[ -f "$HOME/.env" ]]; then
  HA_PORT=$(grep -oP '^HA_PORT=\K.*' "$HOME/.env" || echo 8123)
  HA_PACKAGES_DIR=$(grep -oP '^HA_PACKAGES_DIR=\K.*' "$HOME/.env" || true)
fi
HA_CONFIG="$HOME/homeassistant"
HA_TZ=$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)

# Host networking means ufw governs access: LAN-only.
sudo ufw allow from 192.168.86.0/22 to any port "$HA_PORT" proto tcp

mkdir -p "$HA_CONFIG"

# Official Container compose (home-assistant.io/installation/linux), minus `privileged` and the
# dbus mount, which only Bluetooth / USB radios need. Regenerated each run.
PACKAGES_VOLUME=""
if [[ -n "$HA_PACKAGES_DIR" ]]; then
  PACKAGES_VOLUME="      - $HA_PACKAGES_DIR:/config/packages:ro"
fi
cat > "$HA_CONFIG/compose.yaml" <<EOF
services:
  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:stable
    network_mode: host
    restart: unless-stopped
    stop_grace_period: 60s
    environment:
      TZ: $HA_TZ
    volumes:
      - $HA_CONFIG:/config
      - /etc/localtime:/etc/localtime:ro
$PACKAGES_VOLUME
EOF

# Seed config on first install only, mirroring HA's own first-run default. HA skips creating
# automations/scripts/scenes when configuration.yaml already exists, so create them here.
if [[ ! -f "$HA_CONFIG/configuration.yaml" ]]; then
  {
    echo "# Loads default set of integrations. Do not remove."
    echo "default_config:"
    echo
    if [[ -n "$HA_PACKAGES_DIR" ]]; then
      echo "homeassistant:"
      echo "  packages: !include_dir_named packages"
      echo
    fi
    if [[ "$HA_PORT" != "8123" ]]; then
      echo "http:"
      echo "  server_port: $HA_PORT"
      echo
    fi
    echo "# Load frontend themes from the themes folder"
    echo "frontend:"
    echo "  themes: !include_dir_merge_named themes"
    echo
    echo "automation: !include automations.yaml"
    echo "script: !include scripts.yaml"
    echo "scene: !include scenes.yaml"
  } > "$HA_CONFIG/configuration.yaml"
fi
[[ -f "$HA_CONFIG/automations.yaml" ]] || echo "[]" > "$HA_CONFIG/automations.yaml"
[[ -f "$HA_CONFIG/scripts.yaml" ]] || touch "$HA_CONFIG/scripts.yaml"
[[ -f "$HA_CONFIG/scenes.yaml" ]] || touch "$HA_CONFIG/scenes.yaml"

docker compose -f "$HA_CONFIG/compose.yaml" up -d

echo "--> waiting for Home Assistant on :$HA_PORT ..."
for _ in $(seq 1 60); do
  curl -s -o /dev/null "http://localhost:$HA_PORT/" && break
  sleep 5
done

# HACS (community store): installed inside the container, then HA restarts to load it.
if [[ ! -d "$HA_CONFIG/custom_components/hacs" ]] && confirm "Install HACS?"; then
  docker exec homeassistant bash -c "curl -fsSL https://get.hacs.xyz | bash -"
  docker restart homeassistant
fi

echo "--> Home Assistant up: onboard at http://$(hostname):$HA_PORT"
echo "--> then Settings > Devices & services > Add Integration > HACS (GitHub device login)"
echo "--> update later: docker compose -f $HA_CONFIG/compose.yaml pull && docker compose -f $HA_CONFIG/compose.yaml up -d"

section_footer "Home Assistant setup"
